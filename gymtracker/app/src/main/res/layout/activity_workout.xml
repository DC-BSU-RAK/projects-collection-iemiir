<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvWorkoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workout"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvWorkoutMotivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#E53935"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvWorkoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#DDDDDD"
            android:lineSpacingExtra="5dp"
            android:background="#1A1A1A"
            android:padding="16dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Track Your Progress"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <CheckBox android:id="@+id/cbExercise1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:buttonTint="#E53935" android:layout_marginBottom="6dp"/>
        <CheckBox android:id="@+id/cbExercise2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:buttonTint="#E53935" android:layout_marginBottom="6dp"/>
        <CheckBox android:id="@+id/cbExercise3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:buttonTint="#E53935" android:layout_marginBottom="6dp"/>
        <CheckBox android:id="@+id/cbExercise4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:buttonTint="#E53935" android:layout_marginBottom="6dp"/>
        <CheckBox android:id="@+id/cbExercise5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:buttonTint="#E53935" android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress: 0 / 5 exercises done ✅"
            android:textSize="14sp"
            android:textColor="#FFD700"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ Rest Timer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="60"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStartTimer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Start Rest Timer ⏱️"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Workout Notes"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etWorkoutNotes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="How did it feel? Add notes here..."
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveWorkout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Workout ⭐"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F57F17"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnBackHomeWorkout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Back Home ⬅️"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2C2C2C"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>