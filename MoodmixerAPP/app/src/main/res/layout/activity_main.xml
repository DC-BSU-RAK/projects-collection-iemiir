<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mood Mixer 🎭"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            android:layout_marginTop="32dp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mix your feelings together ✨"
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="#BB86FC"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT YOUR MOODS"
            android:textSize="12sp"
            android:textColor="#BB86FC"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnHappy"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Happy 😊"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_default"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnAngry"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Angry 😡"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_default"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/btnSleepy"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Sleepy 😴"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_default"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnStressed"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Stressed 😵"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_default"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <Button
            android:id="@+id/btnMix"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Mix Mood ✨"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_mix"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR MOOD RESULT"
                android:textSize="11sp"
                android:textColor="#BB86FC"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap some moods and press Mix! 🎭"
                android:textSize="17sp"
                android:textColor="#E0E0E0"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

        <Button
            android:id="@+id/btnInfo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Info ℹ️"
            android:textSize="14sp"
            android:textColor="#BB86FC"
            android:background="@drawable/btn_info"
            android:stateListAnimator="@null"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>